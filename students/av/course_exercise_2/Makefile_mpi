# Makefile for Course Exercise 2 using MPI

#--- Compiler and Flags ---#
# Define the gfortran as Fortran Compiler (FC)
FC = mpif90

# Define general flags
FFLAGS = -O3 -Wall -fcheck=bounds,do,mem,pointer -mmacosx-version-min=11.1 -cpp -fallow-argument-mismatch

#--- Source and Object Files ---#
# Define the list of object files (.o) explicitly
MOD_OBJS = geometry.o particle.o barnes_hut_module.o
MAIN_OBJ = ex2_mpi.o
OPT_OBJ  = ex2_mpi_single_reduce.o

# Define the name of the final program
TARGET = ex2_mpi
TARGET_OPT = ex2_mpi_single_reduce

#--- Build Rules ---#
# All depends on the target executable
all: $(TARGET) $(TARGET_OPT)

# Rule to link the final executable
$(TARGET): $(MOD_OBJS) $(MAIN_OBJ)
	$(FC) $(FFLAGS) -o $@ $(MOD_OBJS) $(MAIN_OBJ)

$(TARGET_OPT): $(MOD_OBJS) $(OPT_OBJ)
	$(FC) $(FFLAGS) -o $@ $(MOD_OBJS) $(OPT_OBJ)

# Pattern rule to compile source files into object files
%.o: %.f90
	$(FC) $(FFLAGS) $(OMPFLAGS) -c $< -o $@

#--- Module Dependencies ---#
# Dependencies between files
particle.o: geometry.o
barnes_hut_module.o: geometry.o particle.o
ex2_mpi.o: geometry.o particle.o barnes_hut_module.o
ex2_mpi_single_reduce.o: geometry.o particle.o barnes_hut_module.o

#--- Cleaning Rule ---#
# Rule to remove generated files
clean:
	rm -f $(TARGET) $(TARGET_OPT) *.o *.mod output.dat

# Make Targets that are not actual files 
.PHONY: all clean
